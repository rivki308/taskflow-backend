# =====================================================================
# TaskFlow Pro — Backend environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to GitHub!
# =====================================================================

# development | production | test
NODE_ENV=development

# Port of the server (Render sets PORT automatically)
PORT=4000

# PostgreSQL connection string.
# Local (npm run db:local):  postgresql://postgres:postgres@localhost:5433/taskflow
# Cloud (Neon / Supabase):   paste the connection string from the provider (with ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/taskflow

# Secret used to sign JWT tokens. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# How long a login token is valid (e.g. 15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# Which websites (React client) may call the API. Comma separated.
# Example: http://localhost:5173,https://my-taskflow-client.onrender.com
# Use * to allow all origins (not recommended in production).
CORS_ORIGINS=http://localhost:5173

# Max login attempts per IP in 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------
# Seed (demo data). In development, defaults are used if left empty.
# In production the seed REQUIRES these passwords (min 10 characters).
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@taskflow.test
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
