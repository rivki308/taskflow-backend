{
  "name": "taskflow-pro-backend",
  "version": "1.0.0",
  "description": "TaskFlow Pro — Backend API (Express + TypeScript + Prisma + PostgreSQL + JWT + Swagger)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "start:render": "prisma migrate deploy && node dist/database/seed-cli.js --if-empty && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/database/seed-cli.ts",
    "db:seed:prod": "node dist/database/seed-cli.js",
    "db:studio": "prisma studio",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx src/database/seed-cli.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^17.5.0-beta.15",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
